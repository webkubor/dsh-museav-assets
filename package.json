{
  "name": "@dsh-plugins/dsh-museav-assets",
  "version": "0.4.1",
  "description": "MUSE AV 创作工作台：从 DSH 侧栏浏览灵感与可用模型、生成作品并管理项目素材。",
  "type": "module",
  "main": "lib/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": {
      "default": "./package.json"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "prepublishOnly": "npm run check && npm test && node scripts/prepublish-gate.mjs && node scripts/readme-gate.mjs && node scripts/version-sync-gate.mjs",
    "check": "for f in lib/*.js; do node --check \"$f\" || exit 1; done",
    "test": "node --test test/*.test.mjs",
    "deploy": "npm run check && node ../scripts/dsh-dev.mjs deploy",
    "check:dsh": "node ../scripts/dsh-dev.mjs check",
    "rollback": "node ../scripts/dsh-dev.mjs rollback",
    "rollback:npm": "node ../scripts/dsh-dev.mjs rollback --npm",
    "dsh:status": "node ../scripts/dsh-dev.mjs status"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "museav",
    "assets",
    "image-generation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webkubor/dsh-museav-assets.git"
  },
  "bugs": {
    "url": "https://github.com/webkubor/dsh-museav-assets/issues"
  },
  "homepage": "https://github.com/webkubor/dsh-museav-assets#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "README.en.md",
    "cordis.patch.yml",
    "lib",
    "types",
    "locale/*.json",
    "icon.svg"
  ]
}
